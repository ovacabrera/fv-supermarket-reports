# Cloudflare Pages: cabeceras HTTP (Vite copia este archivo a dist/).

# /data/* lo sirve functions/data/[[path]].js desde el KV, con sus propias cabeceras
# (_headers no se aplica a las Functions).

# El index cambia en cada publicación del front: el navegador siempre revalida.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Los assets de Vite llevan hash en el nombre: se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
