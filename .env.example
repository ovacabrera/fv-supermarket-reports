# Copiar a .env (NO se commitea) y completar. Lo usa scripts/publish.mjs.

# Token de API de Cloudflare. Permisos: "Workers KV Storage: Edit" (publicar los datos)
# y "Cloudflare Pages: Edit" (publicar el front con npm run deploy:front).
CLOUDFLARE_API_TOKEN=
# ID de la cuenta (panel de Cloudflare → Workers & Pages → columna derecha).
CLOUDFLARE_ACCOUNT_ID=
# Nombre del proyecto de Pages (queda como https://<nombre>.pages.dev). Si falta, se usa el de wrangler.json.
CF_PAGES_PROJECT=panel-ventas-fv

# Opcional: ruta a la base si no es la de siempre.
# FV_DB_PATH=C:\FacilVirtual\data\fvposdb.script
